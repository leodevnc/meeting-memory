{
  "name": "meeting-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "TMPDIR=/tmp node --import tsx scripts/local-server.ts",
    "build": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "TMPDIR=/tmp node --test --import tsx test/**/*.test.ts",
    "test:integration": "TMPDIR=/tmp node --test --import tsx test/integration.test.ts",
    "synth": "TMPDIR=/tmp node node_modules/aws-cdk/bin/cdk synth --strict"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.883.0",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-transcribe": "^3.883.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@aws-sdk/s3-presigned-post": "^3.883.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.3",
    "aws-cdk": "2.1142.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
